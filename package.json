{
  "name": "toastiq",
  "version": "0.1.0",
  "description": "A modern light-weight toast notification library for React.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "toast",
    "react",
    "notification",
    "snackbar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratyush2312/toastiq.git"
  },
  "homepage": "https://github.com/Pratyush2312/toastiq#readme",
  "bugs": {
    "url": "https://github.com/Pratyush2312/toastiq/issues"
  },
  "author": "Pratyush Singh",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
